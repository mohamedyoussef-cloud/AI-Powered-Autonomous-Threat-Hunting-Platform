{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/sigma_rule_record.schema.json",
  "title": "Canonical Sigma Rule Record",
  "type": "object",
  "required": [
    "rule_id",
    "title",
    "logsource",
    "detection",
    "condition",
    "required_fields",
    "attack_techniques",
    "validation",
    "lineage"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "logsource": {
      "type": "object",
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "product": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "detection": {
      "type": "object",
      "minProperties": 1
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "falsepositives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attack_techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      },
      "uniqueItems": true
    },
    "attack_tactics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "required": [
        "yaml_valid",
        "sigma_valid",
        "status"
      ],
      "properties": {
        "yaml_valid": {
          "type": "boolean"
        },
        "sigma_valid": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "valid",
            "invalid_yaml",
            "invalid_sigma",
            "unsupported",
            "quarantined"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "duplicate_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "split_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage": {
      "type": "object",
      "required": [
        "source_dataset",
        "source_record_id",
        "schema_version",
        "pipeline_version"
      ],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "additionalProperties": false
}
