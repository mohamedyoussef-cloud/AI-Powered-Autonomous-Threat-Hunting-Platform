{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/attack_technique.schema.json",
  "title": "Canonical ATT&CK Technique",
  "type": "object",
  "required": [
    "technique_id",
    "name",
    "platforms",
    "tactics",
    "revoked",
    "deprecated",
    "lineage"
  ],
  "properties": {
    "technique_id": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_subtechnique": {
      "type": "boolean"
    },
    "parent_technique_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^T[0-9]{4}$"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tactics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "data_components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "detection_strategy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "analytic_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "revoked": {
      "type": "boolean"
    },
    "deprecated": {
      "type": "boolean"
    },
    "attack_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage": {
      "type": "object",
      "required": [
        "source_dataset",
        "source_record_id",
        "schema_version",
        "pipeline_version"
      ],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "ingested_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  },
  "additionalProperties": false
}
