{
  "version": "2.0",

  "explicit_platform_hint_confidence": 1.0,

  "rules": [
    {
      "platform": "Windows",
      "field": "source_type",
      "patterns": [
        "wineventlog:",
        "xmlwineventlog:",
        "sysmon"
      ],
      "confidence": 1.0,
      "reason": "Windows event telemetry signature"
    },
    {
      "platform": "Windows",
      "field": "source_name",
      "patterns": [
        "c:\\windows\\",
        "c:\\program files\\"
      ],
      "confidence": 0.95,
      "reason": "Windows filesystem source signature"
    },

    {
      "platform": "Linux",
      "field": "source_type",
      "patterns": [
        "linux_audit",
        "linux_secure",
        "unix:"
      ],
      "confidence": 1.0,
      "reason": "Linux or Unix host telemetry signature"
    },
    {
      "platform": "Linux",
      "field": "source_name",
      "patterns": [
        "/var/log/",
        "/etc/"
      ],
      "confidence": 0.95,
      "reason": "Linux or Unix filesystem source signature"
    },

    {
      "platform": "macOS",
      "field": "source_type",
      "patterns": [
        "macos",
        "darwin",
        "osx"
      ],
      "confidence": 1.0,
      "reason": "Explicit macOS telemetry signature"
    },
    {
      "platform": "macOS",
      "field": "source_name",
      "patterns": [
        "/users/",
        "/applications/",
        "/library/"
      ],
      "confidence": 0.9,
      "reason": "macOS filesystem source signature"
    },

    {
