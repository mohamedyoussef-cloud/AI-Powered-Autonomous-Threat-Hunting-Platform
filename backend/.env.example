PIPELINE_DATA_ROOT=/absolute/path/to/threat_hunting_data_prep/data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Read-only integration with the team's Phase 3 Hypothesis Engine outputs.
# TEAM_PHASE3_ROOT=path/to/phase3/outputs

# --- v3.1 hunt pipeline ---
