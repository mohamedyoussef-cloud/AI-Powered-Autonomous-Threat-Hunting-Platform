DATABASE_URL=sqlite:///./app/data/threathunt_v3.db
PIPELINE_DATA_ROOT=/absolute/path/to/threat_hunting_data_prep/data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Read-only integration with the team's Phase 3 Hypothesis Engine outputs.
# TEAM_PHASE3_ROOT=path/to/phase3/outputs

# --- v3.1 hunt pipeline ---
# Local EVTX samples loaded automatically on first run (comma separated, EVTX-ATTACK-SAMPLES paths)
# EVTX_SAMPLE_PATHS=Execution/exec_sysmon_1_lolbin_pcalua.evtx
RULES_PER_HYPOTHESIS=5
# DETECTION_PLAN_FILE=path/to/detection_plans.jsonl
# Local demo users are enabled only in development. Never expose them publicly.
THREATHUNT_ENV=development
THREATHUNT_AUTH_SECRET=replace-with-unique-32-plus-character-secret
# Before public/network deployment change THREATHUNT_ENV to production,
# set a unique high-entropy AUTH_SECRET, and on a *new* auth DB supply:
# THREATHUNT_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# THREATHUNT_BOOTSTRAP_ADMIN_PASSWORD=generate-a-unique-16-plus-character-password
# Production refuses inherited demo credentials; use HTTPS and real access controls.
# Live Splunk execution (leave empty to stay on the local backend)
# SPLUNK_URL=https://splunk.example:8089
# SPLUNK_TOKEN=
# SPLUNK_INDEX=botsv3
